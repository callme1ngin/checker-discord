DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_GUILD_ID=your_test_server_id_here

# Optional. If set, every message in this Discord channel is treated as a Steam profile/SteamID.
STEAM_VALUE_CHANNEL_ID=your_discord_channel_id_here

# Optional. auto, showmyitems, or lolz. Used for channel-message replies.
STEAM_VALUE_SOURCE=auto

# Optional. Used for Lolz/LZT Market steam-value requests.
LOLZ_TOKEN=your_lzt_market_token_here

# Optional. Needed only if users pass vanity links like steamcommunity.com/id/name.
STEAM_API_KEY=your_steam_web_api_key_here
